{
  "name": "@solana-toolkit/dex",
  "version": "1.0.0",
  "description": "DEX trading: Jupiter aggregator, direct Pump.fun/PumpSwap/Moonit/Raydium swaps, launch bundles, market maker, anti-MEV volume bot, Jito sniping, auto-sell, Raydium pool creation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "@solana/spl-token": "^0.4.9",
    "@raydium-io/raydium-sdk-v2": "^0.2.73-alpha",
    "@solana-toolkit/types": "workspace:*",
    "@solana-toolkit/utils": "workspace:*",
    "@solana-toolkit/rpc-client": "workspace:*",
    "@solana-toolkit/transaction-builder": "workspace:*",
    "@solana-toolkit/solana-programs": "workspace:*",
    "@solana-toolkit/wallet-manager": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
