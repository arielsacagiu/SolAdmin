{
  "name": "@solana-toolkit/solana-programs",
  "version": "1.0.0",
  "description": "On-chain program instruction builders: SPL/Token-2022, Metaplex metadata, Pump.fun bonding curve, PumpSwap, Moonit, Raydium (AMM v4/CPMM/CLMM), OpenBook",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "@solana/spl-token": "^0.4.9",
    "@coral-xyz/anchor": "^0.30.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-web3js-adapters": "^0.9.2",
    "@solana-toolkit/types": "workspace:*",
    "@solana-toolkit/utils": "workspace:*",
    "@solana-toolkit/rpc-client": "workspace:*",
    "@metaplex-foundation/umi-eddsa-web3js": "^0.9.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
