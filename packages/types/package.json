{
  "name": "@solana-toolkit/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for the SolAdmin Solana toolkit monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo",
    "test": "echo 'no tests in types package'"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
