# ==============================================================================
# SolAdmin environment configuration
# ------------------------------------------------------------------------------
# SECURITY WARNING
#   * NEVER commit real values from this file. Keep `.env` out of version
#     control (it is already in .gitignore).
#   * Private keys are NEVER stored in env files. All secret keys live in
#     password-encrypted JSON keystore files (see `wallet keystore --help`).
#   * Keystore passwords can be supplied via `SOLADMIN_KEYSTORE_PASSWORD`
#     for automation, but prefer interactive prompts on machines you share.
#   * Use a dedicated hardware-isolated machine for mainnet automation, keep
#     the OS and dependencies patched, and rotate keys regularly.
# ==============================================================================

# ---- RPC endpoints ------------------------------------------------------------
# Any Solana JSON-RPC endpoint works: Helius, QuickNode, Triton, local validator
# (solana-test-validator, default http://127.0.0.1:8899), or the public RPC.
# A paid/private RPC with WebSocket + sendBundle support is strongly recommended
# for launch and sniping workloads.
SOLADMIN_RPC_URL="https://api.mainnet-beta.solana.com"
SOLADMIN_RPC_WS_URL="wss://api.mainnet-beta.solana.com"
# Cluster used to select program variants: mainnet | devnet | localnet
SOLADMIN_CLUSTER="mainnet"
# Default commitment level: processed | confirmed | finalized
SOLADMIN_COMMITMENT="confirmed"

# ---- Jito bundle submission ----------------------------------------------------
# Default mainnet block engine: https://mainnet.block-engine.jito.wtf
# Regional endpoints: https://<amsterdam|dublin|frankfurt|london|ny|slc|singapore|tokyo>.mainnet.block-engine.jito.wtf
SOLADMIN_JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf"
# Minimum tip (lamports) attached to the last transaction of every bundle.
SOLADMIN_JITO_TIP_LAMPORTS="100000"
# Relay bundles through the /api/v1/transactions endpoint for single trades.
SOLADMIN_JITO_TX_RELAY="true"

# ---- Priority fees -------------------------------------------------------------
# Fallback compute unit price (micro-lamports) when the live monitor is stale.
SOLADMIN_DEFAULT_CU_PRICE_MICROLAMPORTS="200000"
# Hard cap for automatic priority fee scaling.
SOLADMIN_MAX_CU_PRICE_MICROLAMPORTS="10000000"

# ---- Jupiter / Raydium public APIs ---------------------------------------------
# Jupiter Lite API (free tier). Self-host the open-source Jupiter API for full
# sovereignty: https://github.com/jup-ag/jupiter
SOLADMIN_JUPITER_API_BASE="https://lite-api.jup.ag"
# Raydium public pool-info API
SOLADMIN_RAYDIUM_API_BASE="https://api-v3.raydium.io"

# ---- Safety --------------------------------------------------------------------
# GLOBAL SIMULATION MODE. "true" = every transaction is simulated and never
# sent. Production sends require an explicit --execute flag per command AND
# this variable set to "false".
SOLADMIN_SIMULATION_MODE="true"

# ---- Exchange bulk withdrawal (official REST APIs; keys are read here ONLY
# as env vars — they never touch disk elsewhere. Create API keys with
# WITHDRAWAL-ONLY permissions and IP whitelists on each exchange.) -----------
SOLADMIN_BINANCE_API_KEY=""
SOLADMIN_BINANCE_API_SECRET=""
SOLADMIN_OKX_API_KEY=""
SOLADMIN_OKX_API_SECRET=""
SOLADMIN_OKX_API_PASSPHRASE=""
SOLADMIN_BYBIT_API_KEY=""
SOLADMIN_BYBIT_API_SECRET=""
SOLADMIN_BITGET_API_KEY=""
SOLADMIN_BITGET_API_SECRET=""
SOLADMIN_BITGET_API_PASSPHRASE=""
SOLADMIN_GATE_API_KEY=""
SOLADMIN_GATE_API_SECRET=""
SOLADMIN_MEXC_API_KEY=""
SOLADMIN_MEXC_API_SECRET=""

# ---- Keystore ------------------------------------------------------------------
# Optional: unlock password for JSON keystores. If unset, commands prompt.
# Do NOT use on shared machines.
SOLADMIN_KEYSTORE_PASSWORD=""
