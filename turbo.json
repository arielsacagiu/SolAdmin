{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "SOLADMIN_ENV_FILE",
    "RPC_URL",
    "RPC_WS_URL",
    "COMMITMENT",
    "JITO_BLOCK_ENGINE_URL",
    "JITO_TIP_LAMPORTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
